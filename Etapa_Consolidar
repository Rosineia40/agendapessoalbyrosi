      "source": [
        "import json\n",
        "\n",
        "# Nome do arquivo onde as tarefas serão armazenadas\n",
        "ARQUIVO_TAREFAS = \"tarefas.json\"\n",
        "\n",
        "# Estrutura de categorias e prioridades\n",
        "CATEGORIAS = [\"Trabalho\", \"Saúde\", \"Desenvolvimento Pessoal\", \"Lazer\"]\n",
        "PRIORIDADES = {\"Alta\": 1, \"Média\": 2, \"Baixa\": 3}\n",
        "\n",
        "def carregar_tarefas():\n",
        "    try:\n",
        "        with open(ARQUIVO_TAREFAS, \"r\") as file:\n",
        "            return json.load(file)\n",
        "    except FileNotFoundError:\n",
        "        return []\n",
        "\n",
        "def salvar_tarefas(tarefas):\n",
        "    with open(ARQUIVO_TAREFAS, \"w\") as file:\n",
        "        json.dump(tarefas, file, indent=4)\n",
        "\n",
        "def adicionar_tarefa():\n",
        "    descricao = input(\"Descrição da tarefa: \")\n",
        "    print(\"Escolha a categoria:\")\n",
        "    for i, categoria in enumerate(CATEGORIAS, 1):\n",
        "        print(f\"{i}. {categoria}\")\n",
        "    categoria = CATEGORIAS[int(input(\"Número da categoria: \")) - 1]\n",
        "\n",
        "    print(\"Escolha a prioridade:\")\n",
        "    for prioridade in PRIORIDADES:\n",
        "        print(f\"- {prioridade}\")\n",
        "    prioridade = input(\"Digite a prioridade: \")\n",
        "\n",
        "    tarefa = {\"descricao\": descricao, \"categoria\": categoria, \"prioridade\": prioridade}\n",
        "    tarefas = carregar_tarefas()\n",
        "    tarefas.append(tarefa)\n",
        "    salvar_tarefas(tarefas)\n",
        "    print(\"Tarefa adicionada com sucesso!\\n\")\n",
        "\n",
        "def listar_tarefas():\n",
        "    tarefas = carregar_tarefas()\n",
        "    if not tarefas:\n",
        "        print(\"Nenhuma tarefa encontrada.\\n\")\n",
        "        return\n",
        "\n",
        "    tarefas.sort(key=lambda t: PRIORIDADES[t[\"prioridade\"]])\n",
        "    for i, tarefa in enumerate(tarefas, 1):\n",
        "        print(f\"{i}. [{tarefa['prioridade']}] {tarefa['descricao']} - Categoria: {tarefa['categoria']}\")\n",
        "    print()\n",
        "\n",
        "def excluir_tarefa():\n",
        "    listar_tarefas()\n",
        "    tarefas = carregar_tarefas()\n",
        "    if not tarefas:\n",
        "        return\n",
        "\n",
        "    indice = int(input(\"Digite o número da tarefa para excluir: \")) - 1\n",
        "    if 0 <= indice < len(tarefas):\n",
        "        del tarefas[indice]\n",
        "        salvar_tarefas(tarefas)\n",
        "        print(\"Tarefa excluída com sucesso!\\n\")\n",
        "    else:\n",
        "        print(\"Número inválido.\\n\")\n",
        "\n",
        "def menu():\n",
        "    while True:\n",
        "        print(\"=== AGENDA PESSOAL ===\")\n",
        "        print(\"1. Adicionar Tarefa\")\n",
        "        print(\"2. Listar Tarefas\")\n",
        "        print(\"3. Excluir Tarefa\")\n",
        "        print(\"4. Sair\")\n",
        "        opcao = input(\"Escolha uma opção: \")\n",
        "\n",
        "        if opcao == \"1\":\n",
        "            adicionar_tarefa()\n",
        "        elif opcao == \"2\":\n",
        "            listar_tarefas()\n",
        "        elif opcao == \"3\":\n",
        "            excluir_tarefa()\n",
        "        elif opcao == \"4\":\n",
        "            print(\"Saindo...\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"Opção inválida! Tente novamente.\\n\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    menu()\n"
      ],
